{
  "$schema": "https://raw.githubusercontent.com/t8y2/dbx/dev/plugin-framework-current/plugins/manifest.schema.json",
  "manifest_version": 1,
  "id": "io.dbx.ssh",
  "name": "SSH & SFTP",
  "version": "0.4.6",
  "publisher": "xynanan",
  "description": "Full SSH terminal and SFTP workbench plugin for DBX.",
  "icon": "assets/plugin.svg",
  "engines": {
    "dbx": ">=0.5.77",
    "host_api": ">=1.0.0"
  },
  "permissions": [
    "host.events",
    "host.binary",
    "host.filesystem",
    "host.workbench"
  ],
  "entrypoints": {
    "backend": {
      "transport": "stdio-framed",
      "executable": "bin/dbx-plugin-ssh"
    },
    "ui": {
      "root": "ui",
      "entry": "ui/index.html"
    }
  },
  "contributions": [
    {
      "type": "connection-provider",
      "id": "io.dbx.ssh.connection",
      "label": "SSH server",
      "icon": "assets/plugin.svg",
      "database_type": "ssh",
      "description": "SSH terminal and SFTP connection with password, private key, agent, or no authentication.",
      "fields": [
        {
          "key": "display_name",
          "label": "Connection name",
          "type": "text",
          "binding": "name",
          "required": true,
          "default": "SSH server"
        },
        {
          "key": "host",
          "label": "Host",
          "type": "text",
          "binding": "host",
          "required": true,
          "default": "127.0.0.1"
        },
        {
          "key": "port",
          "label": "Port",
          "type": "number",
          "binding": "port",
          "required": true,
          "default": 22
        },
        {
          "key": "username",
          "label": "Username",
          "type": "text",
          "binding": "username",
          "required": true,
          "default": "root"
        },
        {
          "key": "authentication",
          "label": "Authentication",
          "type": "select",
          "binding": "config",
          "default": "password",
          "options": [
            {
              "label": "Password",
              "value": "password"
            },
            {
              "label": "Private key",
              "value": "private-key"
            },
            {
              "label": "Private key, then password",
              "value": "private-key-password"
            },
            {
              "label": "SSH Agent",
              "value": "agent"
            },
            {
              "label": "No authentication",
              "value": "none"
            }
          ]
        },
        {
          "key": "password",
          "label": "Password",
          "type": "password",
          "binding": "password",
          "visible_when": {
            "field": "authentication",
            "one_of": [
              "password",
              "private-key-password"
            ]
          },
          "required_when": {
            "field": "authentication",
            "one_of": [
              "password",
              "private-key-password"
            ]
          }
        },
        {
          "key": "private_key_path",
          "label": "Private key path",
          "type": "text",
          "binding": "config",
          "description": "Desktop: local path. Web/Docker: path on the DBX server or container.",
          "visible_when": {
            "field": "authentication",
            "one_of": [
              "private-key",
              "private-key-password"
            ]
          },
          "required_when": {
            "field": "authentication",
            "one_of": [
              "private-key",
              "private-key-password"
            ]
          }
        },
        {
          "key": "private_key_passphrase",
          "label": "Private key passphrase",
          "type": "password",
          "binding": "secret",
          "visible_when": {
            "field": "authentication",
            "one_of": [
              "private-key",
              "private-key-password"
            ]
          }
        },
        {
          "key": "agent_socket",
          "label": "Agent socket",
          "type": "text",
          "binding": "config",
          "description": "Optional SSH_AUTH_SOCK override. Leave empty for the environment default or Windows Pageant.",
          "visible_when": {
            "field": "authentication",
            "one_of": [
              "agent"
            ]
          }
        },
        {
          "key": "connect_timeout_secs",
          "label": "Connect timeout (seconds)",
          "type": "number",
          "binding": "config",
          "default": 15,
          "description": "SSH handshake and authentication timeout."
        },
        {
          "key": "keepalive_interval_secs",
          "label": "Keepalive interval (seconds)",
          "type": "number",
          "binding": "config",
          "default": 30,
          "description": "Keepalive probe interval; 3 missed probes disconnect the session. 0 disables probes."
        },
        {
          "key": "sudo_source",
          "label": "Sudo credential source",
          "type": "select",
          "binding": "config",
          "default": "custom",
          "options": [
            {
              "value": "custom",
              "label": "Custom (this connection)"
            },
            {
              "value": "global",
              "label": "Global Quick Sudo profile"
            },
            {
              "value": "off",
              "label": "Off"
            }
          ],
          "description": "Where sudo credentials come from: this connection's own values, a shared global profile, or disabled. Ignored on read-only connections."
        },
        {
          "key": "sudo_profile",
          "label": "Quick Sudo profile",
          "type": "text",
          "binding": "config",
          "options_action": "sudo/profiles/options",
          "visible_when": {
            "field": "sudo_source",
            "one_of": [
              "global"
            ]
          },
          "description": "Pick the global Quick Sudo profile to bind; falls back to the workbench binding when empty. Hosts without dynamic options show a text field (profile name or id)."
        },
        {
          "key": "sudo_password",
          "label": "Sudo password override",
          "type": "password",
          "binding": "secret",
          "visible_when": {
            "field": "sudo_source",
            "one_of": [
              "custom"
            ]
          },
          "description": "Password piped to sudo; leave empty to reuse the login password."
        },
        {
          "key": "totp_secret",
          "label": "TOTP secrets",
          "type": "textarea",
          "binding": "secret",
          "visible_when": {
            "field": "sudo_source",
            "one_of": [
              "custom",
              "off"
            ]
          },
          "description": "One secret per line: otpauth:// URI, base32 key, or a static code. Rotating selection avoids reusing a code in the same window. Also answers login-time keyboard-interactive 2FA."
        },
        {
          "key": "auth_flow_mode",
          "label": "2FA flow",
          "type": "select",
          "binding": "config",
          "default": "password_then_otp",
          "visible_when": {
            "field": "sudo_source",
            "one_of": [
              "custom",
              "off"
            ]
          },
          "options": [
            {
              "value": "password_then_otp",
              "label": "Password first, then OTP"
            },
            {
              "value": "password_plus_otp",
              "label": "Password + OTP combined"
            },
            {
              "value": "password_only",
              "label": "Password only"
            }
          ],
          "description": "How login and sudo 2FA prompts are answered."
        },
        {
          "key": "password_prompt_hint",
          "label": "Password prompt hint",
          "type": "text",
          "binding": "config",
          "visible_when": {
            "field": "sudo_source",
            "one_of": [
              "custom",
              "off"
            ]
          },
          "description": "Custom substring that identifies password prompts (e.g. 'identity token')."
        },
        {
          "key": "totp_prompt_hint",
          "label": "OTP prompt hint",
          "type": "text",
          "binding": "config",
          "visible_when": {
            "field": "sudo_source",
            "one_of": [
              "custom",
              "off"
            ]
          },
          "description": "Custom substring that identifies OTP prompts (e.g. 'duo passcode')."
        },
        {
          "key": "sudo_use_pty",
          "label": "Request PTY for sudo commands",
          "type": "boolean",
          "binding": "config",
          "default": false,
          "visible_when": {
            "field": "sudo_source",
            "one_of": [
              "custom"
            ]
          },
          "description": "Some PAM stacks only prompt correctly with a TTY. A bound global profile overrides this with its own preference."
        },
        {
          "key": "read_only",
          "label": "Read only",
          "type": "boolean",
          "binding": "config",
          "default": false,
          "description": "Reject every write operation (SFTP changes, uploads, sudo commands) on this connection; Quick Sudo stays off while enabled."
        }
      ],
      "workbench": "io.dbx.ssh.workbench",
      "filesystem_provider": "io.dbx.ssh.files",
      "actions": [
        {
          "id": "quick-sudo-profiles",
          "label": "Global Quick Sudo profiles",
          "description": "Show the shared global Quick Sudo profiles and this connection's binding.",
          "variant": "outline",
          "when": "always",
          "requires_valid_form": false,
          "timeout_ms": 10000
        }
      ],
      "capabilities": [
        "test",
        "connect",
        "disconnect"
      ]
    },
    {
      "type": "workbench",
      "id": "io.dbx.ssh.workbench",
      "label": "SSH & SFTP Workbench",
      "description": "Interactive terminal and SFTP file manager.",
      "icon": "assets/plugin.svg"
    },
    {
      "type": "filesystem-provider",
      "id": "io.dbx.ssh.files",
      "label": "SFTP files",
      "description": "Remote filesystem exposed through SFTP.",
      "schemes": [
        "sftp"
      ],
      "root_uri": "sftp:/",
      "capabilities": [
        "read",
        "write",
        "delete",
        "rename",
        "mkdir"
      ]
    }
  ],
